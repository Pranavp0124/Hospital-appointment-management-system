<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hospital Appointment System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>
<body>
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Hospital" asp-action="Index">
                City Hospital
            </a>

            <div>
                <a class="btn btn-light btn-sm me-1"
                   asp-controller="Hospital" asp-action="Index">Doctors</a>

                <a class="btn btn-light btn-sm me-1"
                   asp-controller="Hospital" asp-action="Appointment">Appointment</a>

                <a class="btn btn-light btn-sm"
                   asp-controller="Hospital" asp-action="Posts">Posts</a>
            </div>
        </div>
    </nav>

    <main class="container">
        @RenderBody()
    </main>
</body>
</html>
